# Copia este archivo a `.env` y completa los valores. `.env` NO se sube a Git.

# Clave para firmar los tokens JWT (minimo 32 caracteres). Opcional: si se
# deja vacia se genera una temporal en cada arranque (las sesiones se cierran
# al reiniciar el servidor). Para fijarla:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DB_HOST=localhost
DB_PORT=3306
# Valores de la instalacion local de demostracion. Cambialos si tu MySQL usa otros.
DB_USER=root
DB_PASSWORD=1234
DB_NAME=smartbin_wms

# Origenes permitidos para el frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Horas de validez de la sesion
TOKEN_HORAS=8
