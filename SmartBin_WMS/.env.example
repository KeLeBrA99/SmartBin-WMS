# Copia este archivo a `.env` y completa los valores. `.env` NO se sube a Git.

# Clave para firmar los tokens JWT (minimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=smartbin_wms

# Origenes permitidos para el frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Horas de validez de la sesion
TOKEN_HORAS=8
